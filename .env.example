# Copy to `.env.local` and fill in values. Keep secrets only in `.env.local`
# (gitignored). Optional: `vercel env pull .env.some-name` for one-off syncs;
# delete pull outputs when done so you are not juggling many `.env*` files.
#
# Full descriptions: docs/ARCHITECTURE.md — Environment variables
#
# On Vercel, mark bearer/signing secrets as **Sensitive** (see ARCHITECTURE.md
# “Vercel: Sensitive vs plain”). Repo helper: `npm run vercel:mark-sensitive`.

# --- Google Calendar (service account) ---
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=

# --- Calendars and admin ---
PRACTICE_CALENDAR_ID=
JAM_CALENDAR_ID=
ROOM_TIME_ZONE=America/Los_Angeles
ADMIN_EMAIL=
ADMIN_EMAILS=

# --- Notion (integration + data sources) ---
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_FILLOUT_MASTER_DATA_SOURCE_ID=
NOTION_PEOPLE_DB_ID=
NOTION_PROFILE_LOG_DB_ID=

# --- Notion WWU quarters (cron sync + calendar window) ---
NOTION_WWU_QUARTERS_DATA_SOURCE_ID=
# Optional property names (defaults: Name, Start Date, End Date)
NOTION_WWU_QUARTERS_NAME_PROP=
NOTION_WWU_QUARTERS_START_DATE_PROP=
NOTION_WWU_QUARTERS_END_DATE_PROP=

# --- Notion webhooks ---
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Optional: set to 1 for extra webhook debug logs (not for production noise)
NOTION_WEBHOOK_CALENDAR_DEBUG=
# Optional LOCAL ONLY: true allows unsafe body-token fallback outside production/preview. Never set on Vercel.
NOTION_WEBHOOK_ALLOW_UNSAFE_DEV=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Holds ---
ENABLE_TEMP_HOLDS=true

# --- NextAuth / Auth.js ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Fillout (server override + public embed URL; often the same value) ---
FILLOUT_URL=
NEXT_PUBLIC_FILLOUT_URL=

# --- Public site links (baked into client bundle) ---
NEXT_PUBLIC_TELEGRAM_CONTACT_URL=
NEXT_PUBLIC_TELEGRAM_GROUP_URL=

# --- Telegram (support inbox + webhook) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Vercel Cron / manual quarter sync ---
CRON_SECRET=

# --- Sister-app bridge (dalin.calendar) ---
# Shared bearer secret allowing dalin.calendar to receive admin-tagged
# event data on behalf of an admin user. The sister app must send
# `Authorization: Bearer <CALENDAR_BRIDGE_SECRET>` AND `?adminEmail=<x>`.
# The claimed email is only honored when it appears in `ADMIN_EMAILS`.
# Leave blank to disable the bridge entirely.
CALENDAR_BRIDGE_SECRET=
